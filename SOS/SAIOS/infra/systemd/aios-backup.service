[Unit]
Description=AIOS critical data backup (oneshot)
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/studiosislab.com
EnvironmentFile=-/etc/aios/aios.env
ExecStart=/usr/bin/bash /root/studiosislab.com/SOS/SAIOS/infra/scripts/aios-backup.sh
Nice=15

[Install]
WantedBy=multi-user.target
