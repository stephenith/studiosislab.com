# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
# vercel
.vercel

# AIOS / SOS — secrets and nested installs (SOS/.gitignore also applies under SOS/)
SOS/**/node_modules/
SOS/**/.env
SOS/**/.env.local
# Persistent AIOS runtime data (Founder decisions, Resume Templates, memory, logs)
SOS/07_LOGS/saios/
!SOS/07_LOGS/saios/**/.gitkeep
# On-box / off-box backup staging
/aios-backups/
/root-aios-backups/

# typescript
*.tsbuildinfo
next-env.d.ts
app_old/
storage/
