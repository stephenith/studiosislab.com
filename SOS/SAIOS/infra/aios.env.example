# AIOS environment template — copy to /etc/aios/aios.env (mode 600). NEVER commit secrets.
SOS_AIOS_LIVE=0
SOS_AI_FOUNDER_OPENAI_BOUNDED=0
# Legacy alias (accepted by gate if BOUNDED unset): SOS_AI_FOUNDER_OPENAI_ONE_TEST=0
SOS_AI_MONTHLY_BUDGET_USD=20
SOS_AI_DAILY_LIMIT_USD=5
SOS_AI_PER_TASK_TOKEN_LIMIT=50000
SOS_AI_AUTO_PAUSE_THRESHOLD_PCT=80
SOS_AI_FOUNDER_ALERT_THRESHOLD_PCT=70
SOS_AI_SINGLE_TEST_MAX_COST_USD=1
SOS_AIOS_NOTIFY_LIVE=0
SOS_AIOS_PUBLICATION_AUTO_APPLY=0
SOS_AIOS_PUBLICATION_APPLY=0
SOS_AIOS_REVISION_DISPATCHER=1
