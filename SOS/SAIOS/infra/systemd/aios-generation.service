[Unit]
Description=AIOS Resume Template autonomous generation (oneshot)
After=network-online.target aios-founder-dashboard.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/studiosislab.com
Environment=NODE_ENV=production
Environment=SOS_AIOS_LIVE=0
EnvironmentFile=-/etc/aios/aios.env
# flock prevents timer overlap; exit 0 if already running
ExecStart=/usr/bin/flock -n /run/aios-generation.lock /usr/bin/npm run aios:autonomous:run -- --size 5 --queue-max 20
Nice=10

[Install]
WantedBy=multi-user.target
